rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/User/$(request.auth.uid)).data;
    }
    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/User/$(request.auth.uid))
        && myProfile().active == true;
    }
    function isAdmin() {
      return activeUser() && myProfile().role == "admin";
    }
    match /Vehicles/{vehicleId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }
    match /User/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // User profiles/roles must be provisioned by a trusted administrator process.
      allow create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
